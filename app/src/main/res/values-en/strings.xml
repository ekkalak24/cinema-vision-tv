<resources>
    <string name="app_name">CinemaVision TV</string>

    <!-- Calibration Steps -->
    <string name="step_picture_mode">1. Base Picture Mode</string>
    <string name="step_picture_mode_desc">Select Movie / Custom / Filmmaker Mode to disable exaggerated factory processing.</string>
    <string name="step_aspect_ratio">2. 1:1 Pixel Mapping &amp; Overscan</string>
    <string name="step_aspect_ratio_desc">Disable overscan: ensure guide arrows touch screen edges and 1-pixel border is fully visible.</string>
    <string name="step_black_level">3. Black Level &amp; Shadow Detail (PLUGE)</string>
    <string name="step_black_level_desc">Adjust Brightness: ensure bar 16 blends into background while bar 17+ flashes faintly.</string>
    <string name="step_white_level">4. White Level &amp; Highlight Clipping</string>
    <string name="step_white_level_desc">Adjust Contrast: preserve highlights up to bar 234 without clipping or color tint.</string>
    <string name="step_sharpness">5. Sharpness &amp; Edge Ringing</string>
    <string name="step_sharpness_desc">Lower Sharpness until white halo lines vanish from edges and pixel grid remains crisp.</string>
    <string name="step_grayscale">6. D65 White Balance &amp; Grayscale</string>
    <string name="step_grayscale_desc">Set Color Temperature to Warm / Expert 1 (target D65 6500K) for natural skin tones.</string>
    <string name="step_motion_judder">7. 24p Film Cadence &amp; Motion Processing</string>
    <string name="step_motion_judder_desc">Turn OFF Motion Smoothing (TruMotion/Motionflow/MEMC) to restore native 24fps cinematic film cadence.</string>

